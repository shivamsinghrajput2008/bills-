{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Inventory product item in the POS system",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique product ID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Product display name",
          "maxLength": 200
        },
        "category": {
          "type": "string",
          "description": "Product category",
          "maxLength": 100
        },
        "barcode": {
          "type": "string",
          "description": "Product barcode number",
          "maxLength": 64
        },
        "inwardDateTime": {
          "type": "string",
          "description": "Date & time added to inventory",
          "maxLength": 50
        },
        "quantity": {
          "type": "number",
          "description": "Current stock quantity in store"
        },
        "unit": {
          "type": "string",
          "description": "Unit of measurement",
          "maxLength": 30
        },
        "mrp": {
          "type": "number",
          "description": "Maximum Retail Price"
        },
        "rate": {
          "type": "number",
          "description": "Store selling rate"
        },
        "costPrice": {
          "type": "number",
          "description": "Wholesale cost price"
        },
        "shelf": {
          "type": "string",
          "description": "Shelf or rack location in store",
          "maxLength": 60
        },
        "gstRate": {
          "type": "number",
          "description": "GST rate percentage"
        },
        "gstType": {
          "type": "string",
          "description": "GST type e.g. inclusive",
          "maxLength": 30
        },
        "hsn": {
          "type": "string",
          "description": "HSN code",
          "maxLength": 30
        },
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the store merchant",
          "maxLength": 128
        },
        "version": {
          "type": "number",
          "description": "Incremental version number for conflict resolution"
        },
        "lastModifiedByDevice": {
          "type": "string",
          "description": "Device ID or name that performed the update",
          "maxLength": 100
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp string of last modification",
          "maxLength": 50
        }
      },
      "required": ["id", "name", "rate", "ownerId"]
    },
    "Bill": {
      "title": "Bill",
      "description": "Customer invoice and sale checkout transaction",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique bill ID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "invoiceNumber": {
          "type": "string",
          "description": "Invoice number sequence formatted string",
          "maxLength": 64
        },
        "dateTime": {
          "type": "string",
          "description": "Date and time of sale",
          "maxLength": 50
        },
        "customerName": {
          "type": "string",
          "description": "Customer name",
          "maxLength": 100
        },
        "customerPhone": {
          "type": "string",
          "description": "Customer phone number",
          "maxLength": 30
        },
        "paymentMethod": {
          "type": "string",
          "description": "Payment mode: Cash, UPI, Card, Split, etc.",
          "maxLength": 40
        },
        "subtotal": {
          "type": "number",
          "description": "Gross total amount before discounts and taxes"
        },
        "discount": {
          "type": "number",
          "description": "Total discount given"
        },
        "tax": {
          "type": "number",
          "description": "GST tax calculated"
        },
        "total": {
          "type": "number",
          "description": "Net payable total amount in Rupees"
        },
        "itemCount": {
          "type": "number",
          "description": "Total quantity of items in order"
        },
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the cashier/store owner",
          "maxLength": 128
        },
        "version": {
          "type": "number",
          "description": "Incremental version number for conflict resolution"
        },
        "lastModifiedByDevice": {
          "type": "string",
          "description": "Device ID or name that performed the update",
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "string",
          "description": "Last modification timestamp",
          "maxLength": 50
        }
      },
      "required": ["id", "invoiceNumber", "total", "ownerId"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Store contact details and bill configuration",
      "type": "object",
      "properties": {
        "storeName": {
          "type": "string",
          "description": "Store trade name",
          "maxLength": 150
        },
        "storeAddress": {
          "type": "string",
          "description": "Store physical location",
          "maxLength": 300
        },
        "storePhone": {
          "type": "string",
          "description": "Store official contact phone",
          "maxLength": 40
        },
        "storeUpi": {
          "type": "string",
          "description": "UPI VPA ID for dynamic QR code generation",
          "maxLength": 100
        },
        "storeWishes": {
          "type": "string",
          "description": "Invoice footer message",
          "maxLength": 300
        },
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the store owner",
          "maxLength": 128
        },
        "version": {
          "type": "number",
          "description": "Version counter for conflict resolution"
        },
        "lastModifiedByDevice": {
          "type": "string",
          "description": "Device ID or name that updated settings",
          "maxLength": 100
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp",
          "maxLength": 50
        }
      },
      "required": ["storeName", "ownerId"]
    },
    "Subscription": {
      "title": "Subscription",
      "description": "Merchant Pro POS subscription plan and payment record",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique subscription ID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "planId": {
          "type": "string",
          "description": "Selected plan identifier: 6_months or 1_year",
          "maxLength": 30
        },
        "planName": {
          "type": "string",
          "description": "Display name of subscription plan",
          "maxLength": 100
        },
        "originalPrice": {
          "type": "number",
          "description": "Base price before coupon discount"
        },
        "discount": {
          "type": "number",
          "description": "Coupon discount amount applied"
        },
        "finalAmount": {
          "type": "number",
          "description": "Final amount payable/paid via UPI"
        },
        "couponCode": {
          "type": "string",
          "description": "Applied promo or coupon code",
          "maxLength": 30
        },
        "upiId": {
          "type": "string",
          "description": "Payee UPI VPA ID (9771000191@upi)",
          "maxLength": 60
        },
        "utrNumber": {
          "type": "string",
          "description": "UPI transaction reference UTR number",
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "description": "Subscription status: active, pending, expired",
          "maxLength": 30
        },
        "startDate": {
          "type": "string",
          "description": "Subscription start ISO timestamp",
          "maxLength": 50
        },
        "endDate": {
          "type": "string",
          "description": "Subscription expiry ISO timestamp",
          "maxLength": 50
        },
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of merchant",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "description": "Payment creation timestamp",
          "maxLength": 50
        }
      },
      "required": ["id", "planId", "finalAmount", "status", "ownerId"]
    },
    "Device": {
      "title": "Device",
      "description": "Registered active merchant device session for multi-device sync",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique device identifier",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "deviceName": {
          "type": "string",
          "description": "Customizable device label e.g. Counter 1, Mobile",
          "maxLength": 100
        },
        "deviceType": {
          "type": "string",
          "description": "desktop, laptop, tablet, mobile",
          "maxLength": 30
        },
        "browser": {
          "type": "string",
          "description": "Browser name and version",
          "maxLength": 100
        },
        "os": {
          "type": "string",
          "description": "Operating system name",
          "maxLength": 100
        },
        "online": {
          "type": "boolean",
          "description": "Current connection state of device"
        },
        "lastActive": {
          "type": "string",
          "description": "ISO timestamp of last activity heartbeat",
          "maxLength": 50
        },
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of merchant",
          "maxLength": 128
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update ISO timestamp",
          "maxLength": 50
        }
      },
      "required": ["id", "deviceName", "ownerId"]
    }
  },
  "firestore": {
    "/users/{userId}/products/{productId}": {
      "schema": "Product",
      "description": "Store inventory products catalog managed by merchant"
    },
    "/users/{userId}/bills/{billId}": {
      "schema": "Bill",
      "description": "Completed customer billing sales invoices created by merchant"
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": "StoreSettings",
      "description": "Store branding and checkout preferences configured by merchant"
    },
    "/users/{userId}/subscriptions/{subscriptionId}": {
      "schema": "Subscription",
      "description": "Merchant POS subscription records and validity"
    },
    "/users/{userId}/devices/{deviceId}": {
      "schema": "Device",
      "description": "Connected devices and active sessions for multi-device sync"
    }
  }
}
